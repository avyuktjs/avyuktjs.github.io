---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="Page not found." noIndex>
  <section class="not-found">
    <p class="eyebrow">error 404</p>
    <h1>This page wandered off.</h1>
    <p class="lead">
      The link may be broken, or the post may have moved. The home page still
      has everything that's published.
    </p>
    <a class="button" href="/">← back home</a>
  </section>
</Base>
