---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<Base>
  <section class="hero">
    <h1>{SITE.tagline}</h1>
    <button class="search-trigger" type="button" data-open-search>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
      <span>Search posts, tags and authors</span>
      <kbd>/</kbd>
    </button>
  </section>

  <section class="feed" aria-labelledby="posts-heading">
    <div class="feed-heading">
      <h2 class="section-label" id="posts-heading">Latest</h2>
      <span class="feed-count">{String(posts.length).padStart(2, '0')}</span>
    </div>

    <div class="post-list" id="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</Base>
