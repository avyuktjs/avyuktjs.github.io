---
import { SITE } from '../config';

const { pathname } = Astro.url;
const isAbout = pathname.startsWith('/about');
const githubUrl = SITE.github || 'https://github.com';
const discordUrl = SITE.discord || 'https://discord.com';
---

<header class="site-header">
  <div class="header-icons" aria-label="Links">
    <a class="icon-link" href="/" aria-label="Home" title="Home" data-tooltip="Home">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" stroke="none">
        <path d="M12 2 2 10h3v10h6v-6h2v6h6V10h3L12 2z" />
      </svg>
    </a>
    <a class="icon-link" href="/about/" aria-label="About" title="About" data-tooltip="About">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" stroke="none">
        <circle cx="12" cy="12" r="10" />
        <path d="M11 7h2v2h-2zm0 4h2v6h-2z" fill="#000" />
      </svg>
    </a>
    <a class="icon-link" href={githubUrl} aria-label="GitHub" title="GitHub" data-tooltip="GitHub" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" stroke="none">
        <circle cx="12" cy="12" r="10" />
        <g transform="translate(12 12) scale(0.62) translate(-12 -12)" fill="#000">
          <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.2 11.38.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49.99.1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.87.12 3.17.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z" />
        </g>
      </svg>
    </a>
    <a class="icon-link" href={discordUrl} aria-label="Discord" title="Discord" data-tooltip="Discord" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" stroke="none">
        <path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.098.245.201.374.293a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.874.891.077.077 0 0 0-.04.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.182 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
      </svg>
    </a>
  </div>

  <a class="brand" href="/" aria-label={`${SITE.title} — home`}>
    <span class="brand-prompt">{SITE.prompt}</span>{SITE.brand}
  </a>

  <nav class="header-nav" aria-label="Main">
    <button
      class="icon-link search-jump"
      type="button"
      aria-label="Search posts"
      title="Search posts"
      data-tooltip="Search posts"
      data-open-search
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" stroke="none">
        <path d="M10 2a8 8 0 1 0 4.9 14.32l5.39 5.39 1.42-1.42-5.39-5.39A8 8 0 0 0 10 2zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12z" />
      </svg>
    </button>
    <a href="/about/" aria-current={isAbout ? 'page' : undefined}>about</a>
    <a href="/rss.xml">rss</a>
  </nav>
</header>
